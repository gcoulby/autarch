{
  "name": "@autarch/context",
  "version": "1.0.0",
  "description": "Context model service — assembles structured prompts for the LLM narrative layer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
